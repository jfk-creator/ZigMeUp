# --- Zig Build Artifacts (The Essentials) ---
# These are generated by 'zig build' and 'zig run'
zig-cache/
zig-out/
.zig-cache/

# --- C/C++ Interop & Object Files ---
# Since Zig works closely with C, you might generate these accidentally
*.o
*.obj
*.lib
*.a
*.dll
*.dylib
*.so
*.exe
# Exclude .exe only if they are not in specific binary folders you want to keep
# usually 'zig-out' handles this, but stray builds happen.

# --- ZLS (Zig Language Server) ---
# Generated file used for autocompletion and IDE integration
.zls_config.json
compile_commands.json

# --- Editor/IDE Specifics ---

# Vim / Neovim (Swap and backup files)
[._]*.s[a-v][a-z]
!*.svg  # Don't ignore SVG images
[._]*.sw[a-p]
[._]s[a-rt-v][a-z]
[._]ss[a-gi-z]
[._]sw[a-p]
*.swp
*~
*.netrwhist

# VS Code (Personal workspace settings)
.vscode/
# Note: If you WANT to share launch configs for your starter projects, 
# you can comment out '.vscode/' and only ignore the internal files:
# .vscode/*.json
# !.vscode/launch.json
# !.vscode/tasks.json

# JetBrains / IntelliJ / CLion
.idea/
*.iml

# Helix
.helix/

# Sublime Text
*.sublime-workspace
*.sublime-project

# --- OS System Files ---
# Mac
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~

# --- Debugging & Logs ---
*.log
*.pdb
*.gch
